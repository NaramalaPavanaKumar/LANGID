        f"Mess: Breakfast {kb['hostel']['mess']['breakfast']} | Lunch {kb['hostel']['mess']['lunch']} | Dinner {kb['hostel']['mess']['dinner']}",
        "",
        f"Placements Officer: {kb['placements']['officer']} ({kb['placements']['contact']})",
