    lines = [
        f"College: {kb['general']['college_name']} ({kb['general']['short_name']})",
        f"Location: {kb['general']['location']}",
        f"Principal: {kb['general']['principal']}",
        f"Vice Principal: {kb['general']['vice_principal']}",
        f"Helpline: {kb['general']['helpline']} | Email: {kb['general']['email']}",
        f"Website: {kb['general']['website']}",
        "",
        "HODs:",
    ]
    for dept, info in kb['hods'].items():
        lines.append(f"  {dept}: {info['name']} ({info['contact']})")
    lines += [
        "",
        f"Bus Routes: {kb['bus']['routes']}",
        f"Bus Timings: {kb['bus']['timings']}",
