# ── Route: College KB (direct JSON) ──────────────────────────────────────────
@app.route("/college-kb", methods=["GET"])
def college_kb():
    return jsonify(COLLEGE_KB)


# ── Route: Health Check ───────────────────────────────────────────────────────
@app.route("/health", methods=["GET"])
def health():
    return jsonify({
        "status" : "ok",
        "model"  : GEMINI_MODEL,
        "key_set": bool(GEMINI_KEY),
        "version": "4.1.0",
        "zara"   : "active",
        "ask"    : "active"
    })


# ── Quick Terminal Chat ───────────────────────────────────────────────────────
def terminal_chat():
    print("=" * 52)
    print("  Gemini Terminal Test  (Ctrl+C to quit)")
    print(f"  Model : {GEMINI_MODEL}")
    print(f"  Key   : {GEMINI_KEY[:10]}…{GEMINI_KEY[-4:]}")
    print("=" * 52)
    while True:
        try:
            q = input("\nYou: ").strip()
            if not q: continue
            if q.lower() in ("quit","exit","q"):
                print("Bye!"); break
            print("Gemini: thinking…")
            ans = call_gemini(q)
            print(f"\nGemini: {ans}\n")
        except KeyboardInterrupt:
            print("\nBye!"); break


# ── Entry Point ───────────────────────────────────────────────────────────────
if __name__ == "__main__":
    import sys
    if len(sys.argv) > 1 and sys.argv[1] == "chat":
        terminal_chat()
    else:
        print("=" * 52)
        print("  Language ID + ZARA + Ask Anything  v4.1.0")
        print(f"  http://localhost:1000")
        print(f"  Model  : {GEMINI_MODEL}")
        print(f"  Key    : {GEMINI_KEY[:10]}…{GEMINI_KEY[-4:]}")
        print("=" * 52)
        app.run(debug=True, host="0.0.0.0", port=1000)
