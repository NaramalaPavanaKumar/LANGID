    return "\n".join(lines)


# ── Gemini Helper ─────────────────────────────────────────────────────────────
def call_gemini(prompt: str, audio_b64: str = None, mime: str = "audio/webm",
                retries: int = 3, delay: float = 5.0) -> str:
    parts = []
    if audio_b64:
        parts.append({"inline_data": {"mime_type": mime, "data": audio_b64}})
    parts.append({"text": prompt})

    body = json.dumps({
        "contents": [{"parts": parts}],
        "generationConfig": {"temperature": 0.1, "maxOutputTokens": 2048}
    }).encode()

    last_error = None
    for attempt in range(1, retries + 1):
        try:
            req = urllib.request.Request(
                GEMINI_URL, data=body,
                headers={"Content-Type": "application/json", "X-goog-api-key": GEMINI_KEY},
                method="POST"
            )
            with urllib.request.urlopen(req, timeout=45) as resp:
                data = json.loads(resp.read())
            return data["candidates"][0]["content"]["parts"][0]["text"]

        except urllib.error.HTTPError as e:
            status   = e.code
            err_body = e.read().decode(errors="ignore")[:300]
            last_error = f"HTTP {status}: {err_body}"
            print(f"[Gemini] attempt {attempt}/{retries} → {last_error}")
            if status == 429:
                wait = delay * attempt
                print(f"[Gemini] Rate limited — waiting {wait}s…")
                time.sleep(wait)
            elif status in (400, 403, 404):
                break
            else:
                time.sleep(delay)

        except Exception as e:
            last_error = str(e)
            print(f"[Gemini] attempt {attempt}/{retries} error: {last_error}")
            time.sleep(delay)

    raise RuntimeError(f"Gemini failed after {retries} attempts. Last: {last_error}")


def call_gemini_with_history(turns: list, retries: int = 3, delay: float = 5.0) -> str:
    """Call Gemini with a full conversation history (list of {role, parts})."""
    body = json.dumps({
        "contents": turns,
        "generationConfig": {"temperature": 0.7, "maxOutputTokens": 1024}
    }).encode()

    last_error = None
    for attempt in range(1, retries + 1):
        try:
            req = urllib.request.Request(
                GEMINI_URL, data=body,
                headers={"Content-Type": "application/json", "X-goog-api-key": GEMINI_KEY},
                method="POST"
            )
            with urllib.request.urlopen(req, timeout=45) as resp:
                data = json.loads(resp.read())
            return data["candidates"][0]["content"]["parts"][0]["text"]

        except urllib.error.HTTPError as e:
            status   = e.code
            err_body = e.read().decode(errors="ignore")[:300]
            last_error = f"HTTP {status}: {err_body}"
            print(f"[Gemini] attempt {attempt}/{retries} → {last_error}")
            if status == 429:
                wait = delay * attempt
                print(f"[Gemini] Rate limited — waiting {wait}s…")
                time.sleep(wait)
            elif status in (400, 403, 404):
                break
            else:
                time.sleep(delay)

        except Exception as e:
            last_error = str(e)
            print(f"[Gemini] attempt {attempt}/{retries} error: {last_error}")
            time.sleep(delay)

    raise RuntimeError(f"Gemini failed after {retries} attempts. Last: {last_error}")


def extract_json(raw: str):
    clean = re.sub(r"```(?:json)?", "", raw).strip().strip("`").strip()
    return json.loads(clean)


# ── Route: Analyze Audio ──────────────────────────────────────────────────────
@app.route("/analyze", methods=["POST"])
def analyze():
    payload   = request.get_json(force=True)
    audio_b64 = payload.get("audio")
    mime_type = payload.get("mime", "audio/webm")

    if not audio_b64:
        return jsonify({"error": "No audio data provided"}), 400

    prompt = """
You are an expert multilingual speech analyst.
Listen to the audio and respond ONLY with a valid JSON object.
No markdown, no code fences, no explanation — just the raw JSON.

{
  "detected_language": "English",
  "language_code": "en",
  "confidence": 92,
  "language_family": "Indo-European",
  "region": "Global / North America",
  "transcription": "Hello, how are you today?",
  "translation_en": "Hello, how are you today?",
  "translation_hi": "नमस्ते, आप आज कैसे हैं?",
  "emotion": "neutral",
  "emotion_confidence": 85,
  "speaker_count": 1,
  "code_switching": false,
  "secondary_languages": [],
  "noise_level": "low",
  "speech_rate": "normal",
  "script": "Latin"
}

Rules:
- confidence          : integer 0–100
- emotion             : happy | neutral | sad | angry | surprised | fearful
- noise_level         : low | medium | high
- speech_rate         : slow | normal | fast
- translation_en      : ALWAYS provide English translation
- translation_hi      : ALWAYS provide Hindi translation in Devanagari script
- secondary_languages : other language names if code-switching detected
- If no speech found  : detected_language="Unknown", confidence=0, transcription="", translation_en="", translation_hi=""
- Output ONLY the raw JSON, nothing else.
"""

    try:
        raw    = call_gemini(prompt, audio_b64, mime_type)
        result = extract_json(raw)
        result["timestamp"] = time.strftime("%H:%M:%S")
        return jsonify(result)

    except json.JSONDecodeError as e:
        print(f"[parse error] raw={raw[:300]}")
        return jsonify({"error": f"JSON parse error: {e}", "raw": raw[:300]}), 500
    except RuntimeError as e:
        msg = str(e)
        if "429" in msg:
            return jsonify({"error": "Rate limit — wait 30 sec and try again.",
                            "error_type": "rate_limit"}), 429
        return jsonify({"error": msg}), 500
    except Exception as e:
        return jsonify({"error": str(e)}), 500


# ── Route: Translate to any language ─────────────────────────────────────────
@app.route("/translate", methods=["POST"])
def translate():
    payload      = request.get_json(force=True)
    text         = payload.get("text", "").strip()
    target_lang  = payload.get("target_language", "English")
    target_code  = payload.get("target_code", "en")

    if not text:
        return jsonify({"error": "No text provided"}), 400

    prompt = f"""Translate the following text to {target_lang}.
Respond ONLY with a raw JSON object, no markdown, no code fences.

Text to translate: "{text}"

{{
  "translation": "<translated text here>",
  "target_language": "{target_lang}",
  "target_code": "{target_code}"
}}

Output ONLY the JSON, nothing else."""

    try:
        raw = call_gemini(prompt)
        return jsonify(extract_json(raw))
    except RuntimeError as e:
        msg = str(e)
        if "429" in msg:
            return jsonify({"error": "Rate limit — wait 30 sec.", "error_type": "rate_limit"}), 429
        return jsonify({"error": msg}), 500
    except Exception as e:
        return jsonify({"error": str(e)}), 500


# ── Route: Detect Language from Text ─────────────────────────────────────────
@app.route("/detect-text", methods=["POST"])
def detect_text():
    payload = request.get_json(force=True)
    text    = payload.get("text", "").strip()
    if not text:
        return jsonify({"error": "No text provided"}), 400

    prompt = f"""Analyze this text and return ONLY a raw JSON object, no markdown, no code fences.

Text: "{text}"

{{
  "detected_language": "English",
  "language_code": "en",
  "confidence": 95,
  "language_family": "Indo-European",
  "region": "Global",
  "script": "Latin",
  "translation_en": "<English translation>",
  "translation_hi": "<Hindi translation in Devanagari>"
}}

Rules:
- translation_en : always provide English translation
- translation_hi : always provide Hindi translation in Devanagari script
- Output ONLY the JSON, nothing else."""

    try:
        raw = call_gemini(prompt)
        return jsonify(extract_json(raw))
    except RuntimeError as e:
        msg = str(e)
        if "429" in msg:
            return jsonify({"error": "Rate limit — wait 30 sec.", "error_type": "rate_limit"}), 429
        return jsonify({"error": msg}), 500
    except Exception as e:
        return jsonify({"error": str(e)}), 500


# ── Route: ZARA Helpdesk (AI-powered with College KB) ────────────────────────
@app.route("/zara", methods=["POST"])
def zara():
    payload        = request.get_json(force=True)
    question       = payload.get("question", "").strip()
    reply_language = payload.get("reply_language", "English")
    reply_code     = payload.get("reply_code", "en")

    if not question:
        return jsonify({"error": "No question provided"}), 400

    college_info = build_college_context()

    prompt = f"""You are ZARA, the friendly and helpful AI assistant for AUCE (Andhra University College of Engineering), Visakhapatnam.

== COLLEGE KNOWLEDGE BASE ==
{college_info}
== END KNOWLEDGE BASE ==

Student's question: "{question}"

Instructions:
1. Answer the question accurately using ONLY the knowledge base above.
2. Be friendly, helpful, and concise (2-4 sentences max unless listing multiple items).
3. IMPORTANT: Reply in {reply_language} language. If {reply_language} is not English, translate your answer to {reply_language}.
4. If the question is not related to AUCE, politely say you can only help with college-related queries.
5. The numbers in the answer should be in the format of the reply language.
6. Return ONLY a raw JSON object, no markdown, no code fences:

{{
  "answer": "<your answer in {reply_language}>",
  "answer_en": "<English version of answer>",
  "topic": "<one of: hod|principal|bus|canteen|hostel|placement|exam|route|contact|general|off_topic>",
  "reply_language": "{reply_language}",
  "reply_code": "{reply_code}"
}}

Output ONLY the JSON, nothing else."""

    try:
        raw = call_gemini(prompt)
        result = extract_json(raw)
        return jsonify(result)
    except RuntimeError as e:
        msg = str(e)
        if "429" in msg:
            return jsonify({"error": "Rate limit — wait 30 sec.", "error_type": "rate_limit"}), 429
        return jsonify({"error": msg}), 500
    except Exception as e:
        return jsonify({"error": str(e)}), 500


# ── Route: Ask Anything (general AI, no KB, conversation history) ─────────────
@app.route("/ask", methods=["POST"])
def ask_anything():
    """
    General AI — no college KB, no topic restrictions.
    Payload: {
      question       : str,
      reply_language : str  (e.g. "Telugu"),
      reply_code     : str  (e.g. "te"),
      history        : list of {role: "user"|"model", content: str}  (optional)
    }
    """
    payload        = request.get_json(force=True)
    question       = payload.get("question", "").strip()
    reply_language = payload.get("reply_language", "English")
    reply_code     = payload.get("reply_code", "en")
    history        = payload.get("history", [])

    if not question:
        return jsonify({"error": "No question provided"}), 400

    sys_text = (
        f"You are a helpful, knowledgeable AI assistant with no topic restrictions. "
        f"Answer any question accurately, clearly, and helpfully. "
        f"Reply in {reply_language} language (code: {reply_code}). "
        f"If the question is in a different language, still reply in {reply_language}. "
        f"Be concise and direct. Do not use emojis."
    )

    # Build Gemini content turns from history
    turns = []

    # Inject system instructions as first user+model exchange so Gemini respects them
    turns.append({"role": "user",  "parts": [{"text": f"[SYSTEM] {sys_text}"}]})
    turns.append({"role": "model", "parts": [{"text": "Understood. I will follow those instructions."}]})

    # Add prior conversation (keep last 18 turns to stay within limits)
    for h in history[-18:]:
        role = h.get("role", "user")
        if role not in ("user", "model"):
            role = "user"
        turns.append({"role": role, "parts": [{"text": h.get("content", "")}]})

    # Add the new question
    turns.append({"role": "user", "parts": [{"text": question}]})

    try:
        answer = call_gemini_with_history(turns)
        return jsonify({
            "answer":          answer,
            "reply_language":  reply_language,
            "reply_code":      reply_code
        })
    except RuntimeError as e:
        msg = str(e)
        if "429" in msg:
            return jsonify({"error": "Rate limit — wait 30 sec.", "error_type": "rate_limit"}), 429
        return jsonify({"error": msg}), 500
    except Exception as e:
        return jsonify({"error": str(e)}), 500


# ── Route: Supported Languages ────────────────────────────────────────────────
_language_cache = None
_language_cache_time = 0
LANGUAGE_CACHE_TTL = 3600

@app.route("/languages", methods=["GET"])
def languages():
    global _language_cache, _language_cache_time

    if _language_cache and (time.time() - _language_cache_time) < LANGUAGE_CACHE_TTL:
        return jsonify(_language_cache)

    prompt = """List the 60 most widely spoken languages in the world.
Return ONLY a raw JSON array (no markdown, no code fences) where each item has:
{
  "code": "<ISO 639-1 2-letter code>",
  "name": "<English name>",
  "native_name": "<name in that language's own script>",
  "family": "<language family>",
  "region": "<primary region(s)>",
  "script": "<writing system name>"
}

Include: English, Mandarin Chinese, Hindi, Spanish, French, Arabic, Bengali, Portuguese,
Russian, Urdu, Indonesian, German, Japanese, Swahili, Marathi, Telugu, Tamil, Turkish,
Korean, Vietnamese, Italian, Thai, Gujarati, Polish, Ukrainian, Dutch, Malay, Kannada,
Malayalam, Punjabi, Odia, Burmese, Hausa, Yoruba, Igbo, Amharic, Somali, Zulu, Xhosa,
Afrikaans, Persian/Farsi, Pashto, Kurdish, Azerbaijani, Uzbek, Kazakh, Serbian, Czech,
Romanian, Hungarian, Greek, Hebrew, Sinhala, Nepali, Tibetan, Mongolian, Khmer, Lao, Javanese.

Return ONLY the raw JSON array, nothing else."""

    try:
        raw  = call_gemini(prompt)
        data = extract_json(raw)
        if not isinstance(data, list):
            raise ValueError("Expected a list")
        _language_cache      = data
        _language_cache_time = time.time()
        return jsonify(data)
    except Exception as e:
        print(f"[languages] Gemini failed, using fallback: {e}")
        fallback = [
            {"code":"en","name":"English","native_name":"English","family":"Indo-European","region":"Global","script":"Latin"},
            {"code":"zh","name":"Chinese","native_name":"中文","family":"Sino-Tibetan","region":"East Asia","script":"Han"},
            {"code":"hi","name":"Hindi","native_name":"हिन्दी","family":"Indo-European","region":"South Asia","script":"Devanagari"},
            {"code":"es","name":"Spanish","native_name":"Español","family":"Indo-European","region":"Europe / Latin America","script":"Latin"},
            {"code":"fr","name":"French","native_name":"Français","family":"Indo-European","region":"Europe / Africa","script":"Latin"},
            {"code":"ar","name":"Arabic","native_name":"العربية","family":"Afro-Asiatic","region":"Middle East / N. Africa","script":"Arabic"},
            {"code":"bn","name":"Bengali","native_name":"বাংলা","family":"Indo-European","region":"South Asia","script":"Bengali"},
            {"code":"pt","name":"Portuguese","native_name":"Português","family":"Indo-European","region":"Europe / Brazil","script":"Latin"},
            {"code":"ru","name":"Russian","native_name":"Русский","family":"Indo-European","region":"Eastern Europe","script":"Cyrillic"},
            {"code":"ur","name":"Urdu","native_name":"اردو","family":"Indo-European","region":"South Asia","script":"Perso-Arabic"},
            {"code":"id","name":"Indonesian","native_name":"Bahasa Indonesia","family":"Austronesian","region":"Southeast Asia","script":"Latin"},
            {"code":"de","name":"German","native_name":"Deutsch","family":"Indo-European","region":"Europe","script":"Latin"},
